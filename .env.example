# =====================================================================
# .env.example  -  TEMPLATE ONLY. Safe to commit. Contains NO real secrets.
# Copy to .env and replace every <...> value before running anything:
#     Copy-Item .env.example .env
# .env is git-ignored. Never commit it.
# =====================================================================

# ---------- PostgreSQL server (Docker container: pgvector/pgvector:pg16) ----------
# Container listens on 127.0.0.1:PG_PORT. Change PG_PORT if 5432 is already used.
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=k8s_rag
PG_CONTAINER=k8s-rag-pg
PG_IMAGE=pgvector/pgvector:pg16

# Superuser - becomes POSTGRES_USER / POSTGRES_PASSWORD of the Docker container.
# Used ONLY by scripts\db_docker.ps1 (create roles, DB, extension).
# Never used by the Python app.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=<your-postgres-superuser-password>

# Ingestion role - owns tables, loads documents/chunks/embeddings (trusted backend job)
INGEST_DB_USER=ingest_admin
INGEST_DB_PASSWORD=<choose-a-strong-ingest-password>

# Retrieval role - SELECT only, NOBYPASSRLS, every row filtered by RLS
READER_DB_USER=rag_reader
READER_DB_PASSWORD=<choose-a-strong-reader-password>

# ---------- Embedding model ----------
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
# Optional: local cache folder for the Hugging Face model (~130 MB)
HF_HOME=.cache\huggingface

# ---------- Retrieval ----------
RETRIEVAL_STRATEGY=markdown
TOP_K=5

# ---------- Dataset source ----------
K8S_REPO_URL=https://github.com/kubernetes/website.git
K8S_REF=main

# ---------- Optional: corporate proxy (leave blank if not needed) ----------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
# Optional Hugging Face mirror, e.g. https://hf-mirror.example.com
HF_ENDPOINT=
